      "onError": "continueErrorOutput",
      "position": [
        460,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "Describe this image for a research data catalogue. Return a short title, a factual description and keywords.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You write discovery metadata (schema.org / CDIF) for images deposited in a research data archive. Write in English. Title: at most 12 words, specific and factual, no quotes, no trailing full stop. Description: 2 to 4 sentences saying what the image shows (subjects, setting, visible text, type of image such as photograph, map, chart, scan of a document); do not guess names of people, places or dates that are not visible. Keywords: 5 to 10 short lowercase terms or phrases, most important first, no duplicates."
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "image",
              "imageDetail": "auto"
            }
          ]
        }
      }
    },
    {
      "id": "img-model",
      "name": "Azure OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAzureOpenAi",
      "typeVersion": 1,
      "position": [
        420,
        420
      ],
      "parameters": {
        "model": "gpt-5.6-terra",
        "options": {}
      },
      "credentials": {
        "azureOpenAiApi": {
          "id": "KKIwbsVKQUA5Kqyu",
          "name": "Azure Open AI Modansa Terra"
        }
      }
    },
    {
      "id": "img-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        600,
        420
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\"type\": \"string\"},\n    \"description\": {\"type\": \"string\"},\n    \"keywords\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}\n  },\n  \"required\": [\"title\", \"description\", \"keywords\"]\n}"
      }
    },
    {
      "id": "img-respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, title: $json.output.title, description: $json.output.description, keywords: $json.output.keywords }) }}",
        "options": {}
