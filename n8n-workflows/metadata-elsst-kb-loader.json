    {
      "parameters": {
        "jsCode": "const SKOS_CONCEPT  = 'http://www.w3.org/2004/02/skos/core#Concept';\nconst SKOS_PREF     = 'http://www.w3.org/2004/02/skos/core#prefLabel';\nconst SKOS_ALT      = 'http://www.w3.org/2004/02/skos/core#altLabel';\nconst SKOS_DEF      = 'http://www.w3.org/2004/02/skos/core#definition';\nconst SKOS_BROADER  = 'http://www.w3.org/2004/02/skos/core#broader';\nconst SKOS_NARROWER = 'http://www.w3.org/2004/02/skos/core#narrower';\nconst SKOS_RELATED  = 'http://www.w3.org/2004/02/skos/core#related';\nconst MAX_CHARS = 900;\n\nconst raw = $input.first().json;\nlet graph;\nif (raw.data?.[0]?.['@graph'])   graph = raw.data[0]['@graph'];\nelse if (Array.isArray(raw))      graph = raw[0]?.['@graph'];\nelse if (raw['@graph'])           graph = raw['@graph'];\nelse if (raw['0']?.['@graph'])    graph = raw['0']['@graph'];\n\nif (!graph) {\n  const keys = Object.keys(raw).slice(0, 20);\n  throw new Error(`No @graph found. Keys: ${keys.join(', ')} | Sample: ${JSON.stringify(raw).substring(0, 400)}`);\n}\n\nconst conceptMap = new Map();\nconst childrenMap = new Map();\n\nfor (const node of graph) {\n  const types = node['@type'] || [];\n  if (!types.includes(SKOS_CONCEPT)) continue;\n\n  const uri = node['@id'];\n  const enLabel = (node[SKOS_PREF] || []).find(l => l['@language'] === 'en');\n  const prefLabel = enLabel ? enLabel['@value'] : null;\n  if (!prefLabel) continue;\n\n  const enAltLabels = (node[SKOS_ALT] || []).filter(l => l['@language'] === 'en').map(l => l['@value']);\n\n  const enDef = (node[SKOS_DEF] || []).find(l => l['@language'] === 'en');\n  const definition = enDef\n    ? enDef['@value'].replace(/[\\n\\r]+/g, ' ').replace(/\\s+/g, ' ').substring(0, MAX_CHARS)\n    : '';\n\n  const broaderUris  = (node[SKOS_BROADER]  || []).map(r => r['@id']).filter(Boolean);\n  const relatedUris  = (node[SKOS_RELATED]  || []).map(r => r['@id']).filter(Boolean);\n  const narrowerUris = (node[SKOS_NARROWER] || []).map(r => r['@id']).filter(Boolean);\n\n  if (narrowerUris.length > 0) childrenMap.set(uri, narrowerUris);\n  conceptMap.set(uri, { prefLabel, enAltLabels, definition, broaderUris, relatedUris });\n}\n\nconst levelMap = new Map();\nconst queue = [];\nfor (const [uri, info] of conceptMap) {\n  if (info.broaderUris.length === 0) {\n    levelMap.set(uri, 1);\n    queue.push(uri);\n  }\n}\nwhile (queue.length > 0) {\n  const cur = queue.shift();\n  const curLevel = levelMap.get(cur);\n  for (const childUri of (childrenMap.get(cur) || [])) {\n    if (!levelMap.has(childUri)) {\n      levelMap.set(childUri, curLevel + 1);\n      queue.push(childUri);\n    }\n  }\n}\n\nconst labelMap = {};\nfor (const [uri, info] of conceptMap) labelMap[uri] = info.prefLabel;\n\nconst results = [];\nfor (const [uri, info] of conceptMap) {\n  const { prefLabel, enAltLabels, definition, broaderUris, relatedUris } = info;\n  const level = levelMap.get(uri) || null;\n  const broaderLabels = broaderUris.map(u => labelMap[u]).filter(Boolean);\n\n  let content = `Label: ${prefLabel}`;\n  if (broaderLabels.length > 0) content += `\\nBroader: ${broaderLabels.join(', ')}`;\n  if (definition) content += `\\nDefinition: ${definition}`;\n  if (enAltLabels.length > 0) content += `\\nEntry terms: ${enAltLabels.join(', ')}`;\n\n  results.push({\n    json: {\n      pageContent: content,\n      metadata: { uri, pref_label: prefLabel, alt_labels: enAltLabels, definition, level, related_uris: relatedUris }\n    }\n  });\n}\n\nreturn results;\n"
      },
